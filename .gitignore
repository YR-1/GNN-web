# .gitignore for Analytics Application

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.next-build-verify/
frontend/out/
frontend/build/
frontend/tsconfig.tsbuildinfo
frontend/.env.local
frontend/.env.*.local
frontend/*.pem

# Backend
__pycache__/
backend/venv/
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/*.so
backend/.Python
backend/env/
backend/ENV/
backend/.venv
backend/.env
backend/.env.*.local
backend/models/*.pt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
*.egg-info/
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temp files
tmp/
temp/
*.tmp
backend/.runtime/

# Dependencies lock files (optional - keep them for reproducible builds)
# package-lock.json
# yarn.lock
# Pipfile.lock

.claude/